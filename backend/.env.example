PORT=4000
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://localhost:5432/clinic_dev
# Secrets below (DATABASE_URL, DATA_ENCRYPTION_KEY, JWT_SECRET) may instead be mounted as files and
# referenced with a <NAME>_FILE var — e.g. DATA_ENCRYPTION_KEY_FILE=/run/secrets/encryption_key — so
# production can source them from a secrets manager (Docker/K8s secrets, Vault) instead of this file.
# A directly set value wins over its _FILE.
# 32 random bytes, base64. Generate: openssl rand -base64 32
DATA_ENCRYPTION_KEY=
# Signs staff login tokens. At least 32 chars. Generate: openssl rand -base64 32
JWT_SECRET=
# How long a staff login stays valid (e.g. 12h, 7d)
JWT_EXPIRES_IN=12h
# log = print messages instead of sending them (development)
WHATSAPP_PROVIDER=log
SMS_PROVIDER=log
# Daily long-term treatment reminders (cron, clinic's local time)
REMINDER_CRON=0 9 * * *
TZ=Asia/Karachi
# IANA time zone the clinic's calendar day is computed in (defaults to Asia/Karachi)
CLINIC_TIME_ZONE=Asia/Karachi
