# One file per doctor (copy to infra/clinics/<slug>.env, never commit real ones).
# These values brand and configure that doctor's own copy of the system.
CLINIC_SLUG=dr-ayesha
CLINIC_DOMAIN=drayesha.example.pk
DATABASE_URL=postgresql://user:password@host:5432/dr_ayesha
DATA_ENCRYPTION_KEY=   # 32 random bytes, base64. Generate: openssl rand -base64 32
WHATSAPP_PROVIDER=log  # log | meta-cloud
SMS_PROVIDER=log       # log | <aggregator>
